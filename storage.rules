rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can upload report images
    match /reports/{allPaths=**} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
